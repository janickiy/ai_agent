APP_NAME="Мониторинг строительных новостей"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
HTTP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=Europe/Moscow

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=news_monitor
DB_USERNAME=news_monitor
DB_PASSWORD=news2026
MYSQL_ROOT_PASSWORD=root2026

SESSION_DRIVER=database
SESSION_CONNECTION=null
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=construction_news_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=construction_news_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=construction_news_database_
HORIZON_PREFIX=construction_news_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ACTUALITY_WINDOW_DAYS=7
CATEGORY_CONFIDENCE_THRESHOLD=0.55
AD_CONFIDENCE_THRESHOLD=0.70
SEMANTIC_DUPLICATE_THRESHOLD=0.90
FETCH_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=3
PUBLICATION_OUTPUT_ENABLED=true
ADMIN_CACHE_TTL_SECONDS=60

ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
